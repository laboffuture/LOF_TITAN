# TEMPLATE ONLY - this file IS COMMITTED to a PUBLIC repository.
# Never put a real password, URI, or secret in this file.
# Real values go in server/.env, which is gitignored.
#
#   cp .env.example .env     then edit .env

# MongoDB Atlas connection string.
# Atlas -> Database -> Connect -> Drivers.
# Replace USER and PASSWORD with real values and DELETE the angle brackets that
# Atlas shows around <password> - they are placeholder markers, not syntax.
# URL-encode any of these characters in the password: @ : / ? # [ ] %
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database name to use inside that cluster.
MONGODB_DB=lof_titan

# Secret used to sign session cookies. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Where the API listens.
# NOT 3000 - Docker Desktop's backend binds that port on Windows and answers
# every request with a 404, which looks exactly like a broken API.
PORT=4000

# Browser origin allowed to call this API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Set to "production" behind HTTPS so the session cookie gets the Secure flag.
NODE_ENV=development

# Number of reverse proxies in front of this API. Leave UNSET for local runs.
# Set to 1 when deployed behind Render/Railway/nginx, otherwise rate limiting
# sees only the proxy's IP and buckets every user together. Do NOT set it when
# the API is reachable directly - clients could then spoof X-Forwarded-For and
# bypass the limits.
# TRUST_PROXY=1
