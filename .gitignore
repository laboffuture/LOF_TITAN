# ============================================================
# SECRETS - this repository is PUBLIC.
# Never commit a database URI, API key, or password.
# .env.example files are the only env files that may be tracked.
# ============================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Node / Web App
node_modules/
webapp/node_modules/
webapp/dist/
webapp/.vite/
server/node_modules/

# Python / Firmware
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Build artifacts
build/
dist/
*.bin
*.elf
*.map

# Allow public firmware binaries for Web Serial Flasher
!webapp/public/firmware/*.bin

# ESP32 specific
build-*/
