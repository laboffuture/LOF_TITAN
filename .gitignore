# ============================================================
# SECRETS - this repository is PUBLIC.
# Never commit a database URI, API key, or password.
# .env.example files are the only env files that may be tracked.
# ============================================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Node / Web App
node_modules/
webapp/node_modules/
webapp/dist/
webapp/.vite/
server/node_modules/

# Python / Firmware
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Build artifacts
build/
dist/
*.bin
*.elf
*.map

# Allow public firmware binaries for Web Serial Flasher
!webapp/public/firmware/*.bin

# ESP32 specific
build-*/

# ============================================================
# IMAGES - kit imagery lives on Cloudinary, not in git.
# History already carries 78 MB of deleted images; do not add more.
# Upload with: node scripts/upload-images.mjs
# ============================================================

# Source masters. Put the highest-resolution original you have here.
/art-masters/

# Everything the app used to serve locally is now a Cloudinary public id.
# lab_of_future_logo is the one exception - small chrome inside the IDE modals.
webapp/public/assets/**
!webapp/public/assets/lab_of_future_logo.webp

# Build outputs that were being committed as zips (24 MB).
webapp/releases/
